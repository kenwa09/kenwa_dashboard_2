# URL van de kenwa backend (bijv. https://kenwa.nl in productie, https://kenwa.nl in dev)
KENWA_API_URL=https://kenwa.nl

# Vast, vergrendeld beheerdersadres voor dit dashboard (moet admin zijn op kenwa.nl)
DASHBOARD_LOGIN_EMAIL=ser_syv@hotmail.com

# Sleutel voor het versleutelen van de gecachete kenwa.nl-token (pincode/wachtwoord-login).
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DASHBOARD_SECRET=

# Map waar admin-auth.json (dashboardwachtwoord + pincode) wordt bewaard.
# PRODUCTIE (Coolify): zet dit op een pad met een gekoppeld persistent volume,
# anders verdwijnen wachtwoord en pincode bij elke deployment.
# Laat leeg voor lokaal (valt terug op <projectmap>/server/storage).
DASHBOARD_STORAGE_DIR=
